# LLM provider: auto | anthropic | groq
LLM_PROVIDER=auto

# Optional: Anthropic API for LLM-enhanced agents (heuristic fallback if unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: Groq API (OpenAI-compatible chat endpoint)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# SQLite default; use postgresql+psycopg2://... for Postgres
DATABASE_URL=sqlite:///./data/cinegraph.db

# Generated storyboard PNGs
OUTPUTS_DIR=./outputs

# Comma-separated origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LLM_TEMPERATURE=0.3
LOG_LEVEL=INFO

# Set true when using alembic migrations instead of create_all startup.
USE_MIGRATIONS=false
